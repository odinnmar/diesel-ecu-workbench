{
  "name": "diesel-ecu-workbench",
  "version": "1.2.23",
  "description": "Offline diesel ECU calibration workspace with HP estimator and automatic updates",
  "main": "main.js",
  "author": "Diesel ECU Workbench",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "publish:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.dieselecu.workbench",
    "productName": "Diesel ECU Workbench",
    "icon": "app.ico",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "icon": "app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Diesel-ECU-Workbench-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Diesel ECU Workbench",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "odinnmar",
        "repo": "diesel-ecu-workbench",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/odinnmar/diesel-ecu-workbench.git"
  },
  "homepage": "https://github.com/odinnmar/diesel-ecu-workbench",
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
